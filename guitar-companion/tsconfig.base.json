{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@gsc/contracts": ["./packages/shared/contracts/src/index.ts"],
      "@gsc/music-domain": ["./packages/shared/music-domain/src/index.ts"],
      "@gsc/api/ai-core": ["./packages/api/ai-core/src/index.ts"],
      "@gsc/api/data-access": ["./packages/api/data-access/src/index.ts"],
      "@gsc/api/handlers": ["./packages/api/handlers/src/index.ts"],
      "@gsc/web/ui": ["./packages/web/ui/src/index.ts"],
      "@gsc/web/data-access": ["./packages/web/data-access/src/index.ts"],
      "@gsc/web/feature-home": ["./packages/web/feature-home/src/index.ts"],
      "@gsc/web/routes": ["./packages/web/routes/src/index.ts"],
      "@gsc/web/image-tools": ["./packages/web/image-tools/src/index.ts"],
      "@gsc/web/feature-import": ["./packages/web/feature-import/src/index.ts"],
      "@gsc/web/feature-phrases": [
        "./packages/web/feature-phrases/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
