# Copy to .env (gitignored) for local development. Never commit real values.
# The API reads these via apps/api local.settings.json, which `nx serve api`
# generates from this file. Deployed values live in Azure app settings.

# Version string reported by /api/health.
APP_VERSION=dev

# AI provider: fake (default, free, deterministic) | openai | claude
AI_PROVIDER=fake
# Seconds before a recognition request is abandoned (milliseconds).
AI_TIMEOUT_MS=60000
# Independent readings per image, run in parallel. Notes the readings disagree
# on are highlighted for review. 1 halves the AI cost but loses that signal.
AI_PASSES=2
# Optional cap on provider output tokens.
AI_MAX_OUTPUT_TOKENS=

# OpenAI (AI_PROVIDER=openai): a vision-capable model is required.
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (AI_PROVIDER=claude): model defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# MongoDB connection. Leave empty to run without a database (health reports not-configured).
# Example local: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=gsc

# Enables test-only seeding endpoints. Must never be true in a deployed environment.
E2E_MODE=false
